PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shivasha
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://devops-saurabhpandey.github.io/shivasha

# Optional: public YouTube video search (keep API key only in the private server environment)
YOUTUBE_API_KEY=

# Required for persistent image and video hosting in Content Studio
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: MSG91 SMS alerts for new software enquiries
# Use an approved MSG91 Flow/SMS template. For India, complete required DLT setup.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Comma-separated numbers in international digits format, e.g. 91XXXXXXXXXX
SHIVASHA_ENQUIRY_SMS_TO=

# SHIVASHA AI Assistant (keep this key only in the private server environment)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
