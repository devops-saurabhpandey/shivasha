# Dedicated SHIVASHA YouTube render worker image.
# Build from the repository root: docker build -f server/Dockerfile.youtube-worker -t shivasha-youtube-worker ./server
FROM node:20-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

# FFmpeg is required by scripts/renderYouTubeProject.js.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install --omit=dev

COPY . .

# Fail early with a clear message if required configuration is absent.
CMD ["npm", "run", "youtube:worker"]
