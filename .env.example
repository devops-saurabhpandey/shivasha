# Copy this file to .env and fill in real values. Never commit your real .env.
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/shivasha?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:8080

# Optional cinematic render worker (needed only with --profile cinematic)
# Use the same long random token in API and worker; never commit the real value.
CINEMATIC_RENDER_WORKER_TOKEN=replace-with-a-long-random-worker-token
CINEMATIC_RENDER_POLL_MS=15000

# Required for source uploads and rendered MP4 storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
