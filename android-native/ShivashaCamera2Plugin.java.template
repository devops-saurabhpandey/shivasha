package com.shivasha.next;

import android.Manifest;
import android.content.Context;
import android.hardware.camera2.CameraCharacteristics;
import android.hardware.camera2.CameraManager;
import android.os.Build;

import com.getcapacitor.JSArray;
import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.PermissionState;
import com.getcapacitor.annotation.CapacitorPlugin;
import com.getcapacitor.annotation.Permission;
import com.getcapacitor.annotation.PermissionCallback;

@CapacitorPlugin(
    name = "ShivashaCamera2",
    permissions = { @Permission(alias = "camera", strings = { Manifest.permission.CAMERA }) }
)
public class ShivashaCamera2Plugin extends Plugin {
    @PluginMethod
    public void getCameraInfo(PluginCall call) {
        if (getPermissionState("camera") != PermissionState.GRANTED) {
            requestPermissionForAlias("camera", call, "cameraPermissionCallback");
            return;
        }
        readCameraInfo(call);
    }

    @PermissionCallback
    private void cameraPermissionCallback(PluginCall call) {
        if (getPermissionState("camera") == PermissionState.GRANTED) {
            readCameraInfo(call);
        } else {
            call.reject("Camera permission is required to inspect Camera2 capabilities.");
        }
    }

    private void readCameraInfo(PluginCall call) {
        try {
            CameraManager manager = (CameraManager) getContext().getSystemService(Context.CAMERA_SERVICE);
            for (String id : manager.getCameraIdList()) {
                CameraCharacteristics c = manager.getCameraCharacteristics(id);
                Integer facing = c.get(CameraCharacteristics.LENS_FACING);
                if (facing == null || facing != CameraCharacteristics.LENS_FACING_BACK) continue;

                Float maxDigitalZoom = c.get(CameraCharacteristics.SCALER_AVAILABLE_MAX_DIGITAL_ZOOM);
                Float maxZoomRatio = maxDigitalZoom;
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                    android.util.Range<Float> range = c.get(CameraCharacteristics.CONTROL_ZOOM_RATIO_RANGE);
                    if (range != null) maxZoomRatio = range.getUpper();
                }

                Integer level = c.get(CameraCharacteristics.INFO_SUPPORTED_HARDWARE_LEVEL);
                JSObject result = new JSObject();
                result.put("cameraId", id);
                result.put("facing", "BACK");
                result.put("hardwareSupportLevel", hardwareLevelName(level));
                result.put("maxDigitalZoom", maxDigitalZoom == null ? 1.0 : maxDigitalZoom.doubleValue());
                result.put("maxZoomRatio", maxZoomRatio == null ? 1.0 : maxZoomRatio.doubleValue());
                result.put("androidApiLevel", Build.VERSION.SDK_INT);

                JSArray focalLengths = new JSArray();
                float[] focal = c.get(CameraCharacteristics.LENS_INFO_AVAILABLE焦CAL_LENGTHS);
                if (focal != null) for (float value : focal) focalLengths.put(value);
                result.put("focalLengthsMm", focalLengths);

                JSArray capabilities = new JSArray();
                int[] caps = c.get(CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES);
                if (caps != null) {
                    for (int cap : caps) {
                        if (cap == CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES_MANUAL_SENSOR) capabilities.put("MANUAL_SENSOR");
                        if (cap == CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES_RAW) capabilities.put("RAW");
                        if (cap == CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES_BURST_CAPTURE) capabilities.put("BURST_CAPTURE");
                        if (cap == CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES_MANUAL_POST_PROCESSING) capabilities.put("MANUAL_POST_PROCESSING");
                    }
                }
                result.put("capabilities", capabilities);

                int[] ois = c.get(CameraCharacteristics.LENS_INFO_AVAILABLE_OPTICAL_STABILIZATION);
                result.put("oisAvailable", containsMode(ois, CameraCharacteristics.LENS_OPTICAL_STABILIZATION_MODE_ON));
                int[] eis = c.get(CameraCharacteristics.CONTROL_AVAILABLE_VIDEO_STABILIZATION_MODES);
                result.put("videoStabilizationAvailable", containsMode(eis, CameraCharacteristics.CONTROL_VIDEO_STABILIZATION_MODE_ON));
                call.resolve(result);
                return;
            }
            call.reject("No rear-facing Camera2 camera was found.");
        } catch (SecurityException e) {
            call.reject("Camera permission is required.", e);
        } catch (Exception e) {
            call.reject("Unable to read Camera2 characteristics: " + e.getMessage(), e);
        }
    }

    private boolean containsMode(int[] modes, int expected) {
        if (modes == null) return false;
        for (int mode : modes) if (mode == expected) return true;
        return false;
    }

    private String hardwareLevelName(Integer level) {
        if (level == null) return "UNKNOWN";
        switch (level) {
            case CameraCharacteristics.INFO_SUPPORTED_HARDWARE_LEVEL_LEGACY: return "LEGACY";
            case CameraCharacteristics.INFO_SUPPORTED_HARDWARE_LEVEL_LIMITED: return "LIMITED";
            case CameraCharacteristics.INFO_SUPPORTED_HARDWARE_LEVEL_FULL: return "FULL";
            case CameraCharacteristics.INFO_SUPPORTED_HARDWARE_LEVEL_3: return "LEVEL_3";
            case CameraCharacteristics.INFO_SUPPORTED_HARDWARE_LEVEL_EXTERNAL: return "EXTERNAL";
            default: return "UNKNOWN";
        }
    }
}
